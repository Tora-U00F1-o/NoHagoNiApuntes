# ==============================================================================
# Git Ignore - Entorno de Estudio Universitario
# ==============================================================================

# Carpeta de compilación y artefactos generados (se compila en CI con GitHub Actions)
dist/

# Dependencias de paquetes
node_modules/

# Archivos comprimidos y descargas temporales
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Logs y registros de ejecución
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos temporales de edición y respaldos
*.tmp
*.temp
*.bak
*.old
*.swp
*.swo
*~

# Archivos de sistema operativo (Windows, macOS, Linux)
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*
.directory

# Configuración y almacenamiento temporal de IDEs y editores
.idea/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Asistentes locales y cachés de extensiones
.qodo/
.gemini/
.claude/

# Artefactos de compilación local en proyectos de ejemplo (.NET/C#)
**/bin/
**/obj/
