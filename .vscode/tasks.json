{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Servidor local (build + recarga al guardar)",
      "type": "shell",
      "command": "npm run start",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Preparadas|build",
          "endsPattern": "http://127\\.0\\.0\\.1:\\d+/"
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Comprobar apuntes",
      "type": "shell",
      "command": "npm run check",
      "problemMatcher": []
    }
  ]
}
